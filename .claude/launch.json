{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "drift-web",
      "runtimeExecutable": "trunk",
      "runtimeArgs": [
        "serve",
        "--config",
        "apps/web/Trunk.toml"
      ],
      "port": 8080
    },
    {
      "name": "drift-web-release",
      "runtimeExecutable": "trunk",
      "runtimeArgs": [
        "serve",
        "--config",
        "apps/web/Trunk.toml",
        "--release",
        "--cargo-profile",
        "web-release",
        "--port",
        "8081",
        "--dist",
        "../../target/dist-release"
      ],
      "port": 8081
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "website-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "preview",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    }
  ]
}
