# A toggle clamp: two links between a fixed pivot and a slider on a level guide, with a
# handle at a set angle to the first link.
point anchor at 0,0 fixed
construction line guide from 0,0 to 160,0 fixed
fix guide.end
line linka from anchor to 48,20 length 52
line linkb from linka.end to 96,0 length 52
on linkb.end guide
line handle from linka.end to 60,70 length 51.4
dim angle linka handle = 55°
