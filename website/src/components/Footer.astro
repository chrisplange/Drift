---
import { site } from "../site.config.mjs";
const year = new Date().getFullYear();
---

<!-- The footer is the sheet's title block. -->
<footer class="site-footer">
  <div class="wrap">
    <div class="block">
      <div class="cell name">
        <span class="label">Project</span>
        <a class="brand" href="/">DRIFT</a>
        <p>2D technical illustration for designers and artists. In beta.</p>
      </div>
      <nav class="cell" aria-label="Footer">
        <span class="label">Get it</span>
        <a href="/download/">Download</a>
        <a href="/app/">Try the demo</a>
        <a href="/releases/">Release notes</a>
      </nav>
      <nav class="cell" aria-label="Learn">
        <span class="label">Learn</span>
        <a href="/guide/">User guide</a>
        <a href="/guide/getting-started/">Getting started</a>
        <a href="/guide/reference/keyboard-shortcuts/">Keyboard shortcuts</a>
      </nav>
      <nav class="cell" aria-label="Project">
        <span class="label">Project</span>
        <a href={site.repoUrl}>Drift on GitHub</a>
        <a href={`${site.repoUrl}/issues`}>Report a problem</a>
        <a href="/licence/">Licence</a>
      </nav>
    </div>
    <div class="legal">
      <span>© {year} Christopher Lange</span>
      <span>Drift is proprietary software.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    padding: 0 0 28px;
    font-size: 0.92rem;
  }
  .block {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    border: 2px solid var(--text);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 18px;
    border-left: 1px solid var(--text);
    min-width: 0;
  }
  .cell:first-child {
    border-left: 0;
  }
  .label {
    margin-bottom: 4px;
  }
  .brand {
    color: var(--accent);
    font: 900 2rem/1 var(--display);
    font-stretch: 80%;
    text-decoration: none;
  }
  .name p {
    color: var(--text-weak);
    margin: 6px 0 0;
    max-width: 24em;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-weak);
  }
  @media (max-width: 760px) {
    .block {
      grid-template-columns: 1fr 1fr;
    }
    .name {
      grid-column: 1 / -1;
      border-bottom: 1px solid var(--text);
    }
    .cell:nth-child(2) {
      border-left: 0;
    }
    .cell:nth-child(4) {
      grid-column: 1 / -1;
      border-left: 0;
      border-top: 1px solid var(--text);
    }
  }
</style>
