---
// The front page's living backdrop: a drawing fixed behind the page that plays out as the
// whole page scrolls, about precision and freedom. A section through a mechanical plate
// draws itself and is pinned down by relations and dimensions until it's fully defined.
// Then the plate's strokes flow into an ink drawing of a woman in a wide-brimmed hat, the
// section's hatch following its region to the underside of the brim, where it settles into
// dots. Her lines swirl into an italic serif ampersand with a lipstick-red echo; the
// ampersand unfolds into the street elevation of a Philadelphia rowhouse, dimensioned in
// feet and inches and hatched in brick; and then the whole drawing fades away.
//
// Everything is drawn by the script below from one progress value, the page's scroll
// position: timings live in PHASES, the plate in PLATE, the woman in src/lib/woman.ts, the
// ampersand in src/lib/ampersand.ts and the rowhouse in HOUSE. Its colours are the
// --figure-* tokens in global.css.
---

<div class="sketch-bg" aria-hidden="true">
  <svg viewBox="0 0 1000 680" preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id="ss-grid-minor" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" class="grid-minor"></path>
      </pattern>
      <pattern id="ss-grid" width="100" height="100" patternUnits="userSpaceOnUse">
        <rect width="100" height="100" fill="url(#ss-grid-minor)"></rect>
        <path d="M100 0H0V100" class="grid-major"></path>
      </pattern>
      <!-- The section hatch, which ends up under the brim of the hat. -->
      <pattern id="ss-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect id="ss-hatch-bar" class="hatch-bar" width="1" height="8"></rect>
      </pattern>
      <!-- The dots the hatch settles into under the brim. -->
      <pattern id="ss-dots" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <circle class="dot" cx="4.5" cy="4.5" r="1.7"></circle>
      </pattern>
      <!-- Running-bond brick, for the rowhouse's front. -->
      <pattern id="ss-brick" width="19" height="16" patternUnits="userSpaceOnUse">
        <path class="brick-line" d="M0 0.5H19M0 8.5H19M0.5 0.5V8.5M10 8.5V16"></path>
      </pattern>
      <clipPath id="ss-hatch-region">
        <polygon id="ss-region-a"></polygon>
        <polygon id="ss-region-b"></polygon>
      </clipPath>
      <clipPath id="ss-hair-clip">
        <polygon id="ss-hair-region"></polygon>
      </clipPath>
      <clipPath id="ss-brim-clip">
        <path id="ss-brim-clip-path"></path>
      </clipPath>
      <clipPath id="ss-hatch-reveal">
        <rect id="ss-reveal-rect" x="-200" y="-200" width="0" height="1080"></rect>
      </clipPath>
      <clipPath id="ss-house-clip">
        <path id="ss-house-clip-path" clip-rule="evenodd"></path>
      </clipPath>
    </defs>
    <rect id="ss-grid-layer" x="-3000" y="-3000" width="7000" height="6680" fill="url(#ss-grid)" opacity="0"></rect>
    <g id="ss-camera">
      <g id="ss-fill" class="art" opacity="0"></g>
      <g id="ss-hatch-shape">
        <g clip-path="url(#ss-hatch-reveal)">
          <rect id="ss-hatch-lines" class="hatch" x="-200" y="-200" width="1400" height="1080" clip-path="url(#ss-hatch-region)"></rect>
          <rect id="ss-hatch-dots" class="dots" x="-200" y="-200" width="1400" height="1080" clip-path="url(#ss-hatch-region)" opacity="0"></rect>
        </g>
      </g>
      <g id="ss-amp" opacity="0">
        <path id="ss-amp-kiss" class="amp-kiss"></path>
        <path id="ss-amp-fill" class="amp"></path>
      </g>
      <rect id="ss-brick-layer" class="brick" x="0" y="0" width="1000" height="680" clip-path="url(#ss-house-clip)" opacity="0"></rect>
      <g id="ss-scene"></g>
    </g>
    <g id="ss-measure" visibility="hidden"></g>
  </svg>
</div>

<script>
  import {
    WOMAN_BOUNDS,
    WOMAN_BRIM,
    WOMAN_HAIR_REGION,
    WOMAN_LINES,
    WOMAN_PARTS,
    WOMAN_PATHS,
  } from "../lib/woman";
  import { AMPERSAND, AMPERSAND_SIZE } from "../lib/ampersand";

  // ---------- Timing: windows [from, to] of the page's scroll progress p ----------
  const PHASES = {
    grid: [0.0, 0.02],
    plate: [0.02, 0.1], // the profile strokes, one after another
    centre: [0.08, 0.1],
    hatch: [0.09, 0.13],
    relations: [0.12, 0.16],
    dims: [0.15, 0.22],
    defined: [0.215, 0.23],
    letGo: [0.25, 0.28], // dimensions, relations and grid fade out
    morph: [0.27, 0.4], // strokes peel off the plate and become the woman's lines
    hatchMorph: [0.29, 0.39], // the hatch's region moves from the cut faces to the brim
    fill: [0.38, 0.42], // she fills in
    outline: [0.4, 0.44], // and her outlines fade
    settle: [0.4, 0.45], // the hatch under the brim settles into dots
    release: [0.48, 0.51], // her fill and the dots fade, her lines lift off
    toAmp: [0.49, 0.58], // her lines swirl into an italic ampersand
    ampFill: [0.56, 0.6], // the ampersand fills in
    ampOutline: [0.58, 0.62], // and its outline fades
    kiss: [0.59, 0.63], // a lipstick-red echo slides out from behind it
    ampRelease: [0.66, 0.69], // the ampersand empties back to its outline
    toHouse: [0.67, 0.77], // which unfolds into a rowhouse elevation
    houseDetail: [0.75, 0.81], // muntins, lintels, dentils, steps
    houseDims: [0.79, 0.86], // dimensions in feet and inches
    brick: [0.81, 0.86], // and a brick hatch on the front
    fadeOut: [0.9, 0.97], // then the whole drawing fades away
  } as const;
  // How strongly the backdrop shows behind the page: less on phones, where text covers more
  // of it.
  const strength = () => (window.innerWidth < 760 ? 0.3 : 0.4);

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const ph = (p: number, [a, b]: readonly [number, number]) => clamp((p - a) / (b - a));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  type Pt = [number, number];

  // ---------- The plate: a section through a counterbored mounting plate (viewBox px) ----------
  // Profile strokes, in drawing order. The woman's lines peel off them in turn.
  const PLATE = [
    "M232 300H445",
    "M445 300V336H470V400",
    "M470 400H220V312L232 300",
    "M555 300H768L780 312V400H530",
    "M530 400V336H555V300",
    "M232 300L220 312M768 300L780 312",
  ];
  const CENTRE = "M500 262V438";
  // The cut faces, hatched: left and right of the hole.
  const SECTION_A = "M232 300H445V336H470V400H220V312Z";
  const SECTION_B = "M555 300H768L780 312V400H530V336H555Z";

  // ---------- The woman (src/lib/woman.ts), placed in the viewBox ----------
  // Scale, and the point of the drawing that lands at `to` (the centre of its bounds).
  const FIGURE_PLACE = {
    scale: 0.92,
    from: [(WOMAN_BOUNDS[0] + WOMAN_BOUNDS[2]) / 2, (WOMAN_BOUNDS[1] + WOMAN_BOUNDS[3]) / 2] as const,
    to: [500, 342] as const,
  };
  const toView = ([x, y]: Pt): Pt => [
    FIGURE_PLACE.to[0] + (x - FIGURE_PLACE.from[0]) * FIGURE_PLACE.scale,
    FIGURE_PLACE.to[1] + (y - FIGURE_PLACE.from[1]) * FIGURE_PLACE.scale,
  ];
  // Where the ampersand sits: its scale, centred.
  const AMP_PLACE = { scale: 0.74, to: [500, 340] as const };
  const ampView = ([x, y]: Pt): Pt => [
    AMP_PLACE.to[0] + (x - AMPERSAND_SIZE[0] / 2) * AMP_PLACE.scale,
    AMP_PLACE.to[1] + (y - AMPERSAND_SIZE[1] / 2) * AMP_PLACE.scale,
  ];
  // The camera eases in a touch as she appears.
  const CAMERA = { cx: 500, cy: 342, zoom: 1.03 };

  // ---------- The rowhouse: a Philadelphia street elevation, drawn in feet ----------
  // A three-storey Federal brick front, 16 ft wide: a marble stoop and base, a door with a
  // transom and surround, 6-over-6 windows with stone lintels and sills, a dentilled cornice
  // and a dormer in the roof. HOUSE_PLACE puts the ground line in the viewBox.
  const HOUSE_PLACE = { scale: 13.5, ground: [500, 600] as const, width: 16 };
  const hx = (x: number) => HOUSE_PLACE.ground[0] + (x - HOUSE_PLACE.width / 2) * HOUSE_PLACE.scale;
  const hy = (y: number) => HOUSE_PLACE.ground[1] - y * HOUSE_PLACE.scale;
  const hp = (x: number, y: number): Pt => [hx(x), hy(y)];
  const rect = (x0: number, y0: number, x1: number, y1: number) =>
    `M${hx(x0)} ${hy(y0)}H${hx(x1)}V${hy(y1)}H${hx(x0)}Z`;
  const line = (x0: number, y0: number, x1: number, y1: number) => `M${hx(x0)} ${hy(y0)}L${hx(x1)} ${hy(y1)}`;
  // The windows: [centre, top of sill, head], ground floor first.
  const WINDOWS: [number, number, number][] = [
    [11.75, 4, 10],
    [4.25, 13.5, 19.5],
    [11.75, 13.5, 19.5],
    [4.25, 23, 28],
    [11.75, 23, 28],
  ];
  // Its main lines, which the ampersand's outline unfolds into.
  const HOUSE = [
    line(-5, 0, 21, 0), // the ground
    rect(0, 0, 16, 32), // the front
    rect(-0.5, 32, 16.5, 33.6), // the cornice
    `M${hx(-0.2)} ${hy(33.6)}L${hx(1.6)} ${hy(40)}H${hx(14.4)}L${hx(16.2)} ${hy(33.6)}`, // the roof
    `M${hx(6.2)} ${hy(34.4)}V${hy(37.4)}L${hx(8)} ${hy(39.4)}L${hx(9.8)} ${hy(37.4)}V${hy(34.4)}Z`, // the dormer
    rect(2.75, 3, 5.75, 11.8), // the door and transom
    rect(2.25, 3, 6.25, 12.2), // the door surround
    rect(1.6, 0, 6.9, 3), // the stoop
    ...WINDOWS.map(([c, s, h]) => rect(c - 1.5, s, c + 1.5, h)),
    rect(10.25, 0.6, 13.25, 2.0), // the basement window
  ];
  // The details, drawn in once the main lines are there.
  const HOUSE_DETAIL = [
    line(0, 2.5, 16, 2.5), // the marble water table
    [0.75, 1.5, 2.25].map((y) => line(1.6, y, 6.9, y)).join(""), // the stoop's steps
    line(2.75, 10.5, 5.75, 10.5) + line(3.75, 10.5, 3.75, 11.8) + line(4.75, 10.5, 4.75, 11.8), // the transom
    rect(2.0, 12.2, 6.5, 12.8), // the door's cornice
    rect(3.05, 3.6, 4.15, 9.9) + rect(4.35, 3.6, 5.45, 9.9), // the door's panels
    WINDOWS.map(([c, s, h]) => {
      const m = (s + h) / 2;
      return (
        rect(c - 1.85, h, c + 1.85, h + 0.8) + // lintel
        rect(c - 1.8, s - 0.35, c + 1.8, s) + // sill
        line(c - 1.5, m, c + 1.5, m) + // meeting rail
        line(c - 0.5, s, c - 0.5, h) +
        line(c + 0.5, s, c + 0.5, h) + // 6-over-6 muntins
        line(c - 1.5, (s + m) / 2, c + 1.5, (s + m) / 2) +
        line(c - 1.5, (m + h) / 2, c + 1.5, (m + h) / 2)
      );
    }).join(""),
    [11.0, 11.75, 12.5].map((x) => line(x, 0.6, x, 2.0)).join(""), // the basement window's bars
    Array.from({ length: 23 }, (_, i) => rect(i * 0.7, 32.1, i * 0.7 + 0.35, 32.6)).join(""), // dentils
    rect(7, 35, 9, 37.2) + line(8, 35, 8, 37.2), // the dormer's window
    line(-5, 30.5, 0, 30.5) + line(-5, 31.7, 0, 31.7) + line(16, 33.4, 21, 33.4) + line(16, 34.6, 21, 34.6), // neighbours' cornices
  ];
  // The brick: the front between the water table and the cornice, less its openings.
  const HOUSE_BRICK =
    rect(0, 2.5, 16, 32) +
    WINDOWS.map(([c, s, h]) => rect(c - 1.85, s - 0.35, c + 1.85, h + 0.8)).join("") +
    rect(2.0, 3, 6.5, 12.8);

  // ---------- Sampling paths into points, so any stroke can turn into any other ----------
  const N = 200;
  function sampler(host: SVGGElement) {
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    host.appendChild(path);
    return (d: string, n = N): Pt[] => {
      path.setAttribute("d", d);
      const len = path.getTotalLength();
      return Array.from({ length: n }, (_, i) => {
        const q = path.getPointAtLength((len * i) / (n - 1));
        return [q.x, q.y] as Pt;
      });
    };
  }
  const pts = (ps: Pt[]) => ps.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");

  /** Lines moving from one set of points to another, staggered and swirling. */
  function swirlLines(from: Pt[][], to: Pt[][], t: number, amount: number, spread: number) {
    const n = to.length;
    return to
      .map((target, j) => {
        const tj = ease(clamp((t - (j / n) * spread) / (1 - spread)));
        const swirl = Math.sin(Math.PI * tj) * amount;
        const line = target.map(([bx, by], i) => {
          const [ax, ay] = from[j][i];
          return [
            lerp(ax, bx, tj) + swirl * Math.sin(i * 0.05 + j * 1.7),
            lerp(ay, by, tj) + swirl * Math.cos(i * 0.04 + j * 0.9),
          ] as Pt;
        });
        return `<polyline class="geo fig" points="${pts(line)}"/>`;
      })
      .join("");
  }

  // ---------- Colours: read from the site's tokens ----------
  type RGB = [number, number, number];
  function hex(c: string): RGB {
    const m = c.trim().replace("#", "");
    const n = parseInt(m.length === 3 ? [...m].map((x) => x + x).join("") : m, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  const mix = (a: RGB, b: RGB, t: number) =>
    `rgb(${[0, 1, 2].map((i) => Math.round(lerp(a[i], b[i], t))).join(",")})`;

  // ---------- SVG helpers ----------
  const draw = (t: number) =>
    `pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="${(1 - t).toFixed(4)}" opacity="${t > 0 ? 1 : 0}"`;

  function arrow(x: number, y: number, ux: number, uy: number, k: number) {
    const L = 9 * k,
      H = 3 * k;
    const bx = x - ux * L,
      by = y - uy * L;
    return `M${x} ${y}L${bx - uy * H} ${by + ux * H}L${bx + uy * H} ${by - ux * H}Z`;
  }

  /** An aligned dimension from a to b, `off` px to the left of a→b. */
  function dim(a: Pt, b: Pt, off: number, label: string, t: number, k: number) {
    if (t <= 0) return "";
    const [ax, ay] = a,
      [bx, by] = b;
    const len = Math.hypot(bx - ax, by - ay);
    const ux = (bx - ax) / len,
      uy = (by - ay) / len;
    const nx = uy,
      ny = -ux;
    const p1x = ax + nx * off,
      p1y = ay + ny * off,
      p2x = bx + nx * off,
      p2y = by + ny * off;
    const lineT = clamp(t / 0.6);
    const textT = clamp((t - 0.45) / 0.55);
    const sgn = Math.sign(off) || 1;
    const gap = 4 * k,
      over = 6 * k;
    const ext = (x: number, y: number) =>
      `<line class="ext" x1="${x + nx * gap * sgn}" y1="${y + ny * gap * sgn}" x2="${x + nx * (off + over * sgn)}" y2="${y + ny * (off + over * sgn)}" ${draw(lineT)}/>`;
    let s = ext(ax, ay) + ext(bx, by);
    s += `<line class="dimline" x1="${p1x}" y1="${p1y}" x2="${p2x}" y2="${p2y}" ${draw(lineT)}/>`;
    if (lineT >= 1) s += `<path class="arrow" d="${arrow(p1x, p1y, -ux, -uy, k)}${arrow(p2x, p2y, ux, uy, k)}"/>`;
    let ang = (Math.atan2(uy, ux) * 180) / Math.PI;
    if (ang > 90 || ang < -90) ang += 180;
    // The value sits just above its line as read (ISO).
    const rad = (ang * Math.PI) / 180;
    const mx = (p1x + p2x) / 2 + Math.sin(rad) * 5 * k,
      my = (p1y + p2y) / 2 - Math.cos(rad) * 5 * k;
    if (textT > 0) {
      const lift = (1 - ease(textT)) * 6 * k;
      s += `<g transform="translate(${mx} ${my}) rotate(${ang})" opacity="${textT}"><text class="dimtext" y="${lift}">${label}</text></g>`;
    }
    return s;
  }

  function leader(from: Pt, elbow: Pt, label: string, t: number, k: number) {
    if (t <= 0) return "";
    const end: Pt = [elbow[0] - 40 * k, elbow[1]];
    let s = `<path class="dimline" d="M${from[0]} ${from[1]}L${elbow[0]} ${elbow[1]}H${end[0]}" ${draw(clamp(t / 0.6))}/>`;
    const textT = clamp((t - 0.45) / 0.55);
    if (textT > 0) {
      s += `<text class="dimtext" text-anchor="end" x="${end[0] - 4 * k}" y="${elbow[1] + 4 * k}" opacity="${textT}">${label}</text>`;
    }
    return s;
  }

  function badge(x: number, y: number, glyph: string, t: number, k: number) {
    if (t <= 0) return "";
    const sc = ease(clamp(t * 1.4)) * (1 + 0.25 * Math.sin(Math.PI * clamp(t)));
    const r = 9 * k;
    return `<g class="badge" transform="translate(${x} ${y}) scale(${sc.toFixed(3)})" opacity="${clamp(t * 2)}"><rect x="${-r}" y="${-r}" width="${2 * r}" height="${2 * r}" rx="${3.5 * k}"/><text y="${0.5 * k}">${glyph}</text></g>`;
  }

  /** Staggered windows of `[a, b]`, one per item. */
  const stagger = ([a, b]: readonly [number, number], n: number, i: number, len = 0.035): [number, number] => {
    const step = (b - a - len) / Math.max(1, n - 1);
    return [a + step * i, a + step * i + len];
  };

  // ---------- The frame ----------
  function setup(root: HTMLElement) {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const svg = $<SVGSVGElement>("svg");
    const scene = $<SVGGElement>("#ss-scene");
    const grid = $<SVGRectElement>("#ss-grid-layer");
    const camera = $<SVGGElement>("#ss-camera");
    const hatchPattern = $<SVGPatternElement>("#ss-hatch");
    const hatchBar = $<SVGRectElement>("#ss-hatch-bar");
    const hatchShape = $<SVGGElement>("#ss-hatch-shape");
    const hatchLines = $<SVGRectElement>("#ss-hatch-lines");
    const hatchDots = $<SVGRectElement>("#ss-hatch-dots");
    const regionA = $<SVGPolygonElement>("#ss-region-a");
    const regionB = $<SVGPolygonElement>("#ss-region-b");
    const reveal = $<SVGRectElement>("#ss-reveal-rect");
    const fill = $<SVGGElement>("#ss-fill");
    const amp = $<SVGGElement>("#ss-amp");
    const ampKiss = $<SVGPathElement>("#ss-amp-kiss");
    const brick = $<SVGRectElement>("#ss-brick-layer");

    const { scale, from, to } = FIGURE_PLACE;
    const place = `translate(${to[0] - from[0] * scale} ${to[1] - from[1] * scale}) scale(${scale})`;
    fill.setAttribute("transform", place);
    // Each path is coloured by what it is; path 0 is drawn twice, once as the hat and once,
    // clipped to the area below the brim, as hair.
    fill.innerHTML =
      WOMAN_PATHS.map((d, i) => `<path class="${WOMAN_PARTS[i]}" d="${d}"/>`).join("") +
      `<path class="hair" clip-path="url(#ss-hair-clip)" d="${WOMAN_PATHS[0]}"/>`;
    $<SVGPolygonElement>("#ss-hair-region").setAttribute("points", WOMAN_HAIR_REGION);
    const brimClip = $<SVGPathElement>("#ss-brim-clip-path");
    brimClip.setAttribute("d", WOMAN_BRIM);
    brimClip.setAttribute("transform", place);
    $<SVGPathElement>("#ss-house-clip-path").setAttribute("d", HOUSE_BRICK);

    // Sample everything once.
    const sample = sampler($<SVGGElement>("#ss-measure"));
    const plateS = PLATE.map((d) => sample(d));
    const figureS = WOMAN_LINES.map((d) => sample(d).map(toView));
    const fromPlate = figureS.map((_, j) => plateS[j % plateS.length]);
    // The ampersand's one contour, in as many stretches as she has lines, and again in as
    // many as the rowhouse has.
    const ampOutline = sample(AMPERSAND, N * figureS.length).map(ampView);
    const ampS = figureS.map((_, j) => ampOutline.slice(j * N, (j + 1) * N));
    const ampForHouse = sample(AMPERSAND, N * HOUSE.length).map(ampView);
    const ampHouseS = HOUSE.map((_, j) => ampForHouse.slice(j * N, (j + 1) * N));
    const houseS = HOUSE.map((d) => sample(d));
    const ampPlace = `translate(${AMP_PLACE.to[0] - (AMPERSAND_SIZE[0] / 2) * AMP_PLACE.scale} ${AMP_PLACE.to[1] - (AMPERSAND_SIZE[1] / 2) * AMP_PLACE.scale}) scale(${AMP_PLACE.scale})`;
    for (const el of [ampKiss, $<SVGPathElement>("#ss-amp-fill")]) {
      el.setAttribute("d", AMPERSAND);
      el.setAttribute("transform", ampPlace);
    }
    const sectionA = sample(SECTION_A),
      sectionB = sample(SECTION_B),
      brim = sample(WOMAN_BRIM).map(toView);

    const css = getComputedStyle(document.documentElement);
    const tok = (n: string) => hex(css.getPropertyValue(n) || "#888");
    const C = { under: tok("--under"), ink: tok("--ink") };

    let k = 1; // viewBox units per screen pixel
    const measure = () => {
      const r = svg.getBoundingClientRect();
      const s = Math.min((r.width || 1000) / 1000, (r.height || 680) / 680);
      k = 1 / s;
      svg.style.setProperty("--k", String(k));
      svg.style.setProperty("--tk", String(clamp(1 / (s * 1.55), 1, 2.6)));
    };

    function render(p: number) {
      const definedT = ph(p, PHASES.defined);
      const geo = mix(C.under, C.ink, definedT);
      svg.style.setProperty("--c-geo", geo);
      const letGo = ease(ph(p, PHASES.letGo));
      grid.setAttribute("opacity", String(ph(p, PHASES.grid) * (1 - letGo)));
      root.style.opacity = String(strength() * (1 - ease(ph(p, PHASES.fadeOut))));

      const M = ph(p, PHASES.morph);
      const z = lerp(1, CAMERA.zoom, ease(M));
      camera.setAttribute(
        "transform",
        `translate(${CAMERA.cx} ${CAMERA.cy}) scale(${z.toFixed(4)}) translate(${-CAMERA.cx} ${-CAMERA.cy})`,
      );
      let s = "";

      // The plate's profile, stroke by stroke, until the morph takes over.
      const [pa, pb] = PHASES.plate;
      const per = (pb - pa) / PLATE.length;
      let tip: Pt | undefined;
      PLATE.forEach((d, i) => {
        const t = ph(p, [pa + per * i, pa + per * (i + 1)]);
        if (t > 0 && t < 1) {
          const ps = plateS[i];
          tip = ps[Math.round(t * (ps.length - 1))];
        }
        if (M === 0) s += `<path class="geo" d="${d}" ${draw(t)}/>`;
      });

      // The centre line.
      const centreT = ph(p, PHASES.centre);
      s += `<path class="geo centre" d="${CENTRE}" ${draw(centreT)} style="opacity:${centreT > 0 ? 1 - letGo : 0}"/>`;

      // The plate's strokes become the woman's lines, which fade once she has filled in.
      const outline = 1 - ease(ph(p, PHASES.outline));
      if (M > 0 && outline > 0) {
        s += `<g opacity="${outline.toFixed(3)}">${swirlLines(fromPlate, figureS, M, 26, 0.4)}</g>`;
      }

      // Her lines lift off again and swirl into the ampersand's outline.
      const release = ease(ph(p, PHASES.release));
      const A = ph(p, PHASES.toAmp);
      const ampLines = ease(ph(p, [PHASES.toAmp[0], PHASES.toAmp[0] + 0.02])) * (1 - ease(ph(p, PHASES.ampOutline)));
      if (A > 0 && ampLines > 0) {
        s += `<g opacity="${ampLines.toFixed(3)}">${swirlLines(figureS, ampS, A, 30, 0.35)}</g>`;
      }

      // The ampersand's outline unfolds into the rowhouse.
      const Hs = ph(p, PHASES.toHouse);
      if (Hs > 0) {
        const shown = ease(ph(p, [PHASES.toHouse[0], PHASES.toHouse[0] + 0.02]));
        s += `<g opacity="${shown.toFixed(3)}">${swirlLines(ampHouseS, houseS, Hs, 34, 0.3)}</g>`;
      }
      HOUSE_DETAIL.forEach((d, i) => {
        const t = ph(p, stagger(PHASES.houseDetail, HOUSE_DETAIL.length, i, 0.02));
        if (t > 0) s += `<path class="geo thin" d="${d}" ${draw(t)}/>`;
      });
      brick.setAttribute("opacity", ease(ph(p, PHASES.brick)).toFixed(3));

      // Her fill, until she lets go; the ampersand's fill and its red echo, until it empties.
      const ampGone = 1 - ease(ph(p, PHASES.ampRelease));
      fill.setAttribute("opacity", String(ease(ph(p, PHASES.fill)) * (1 - release)));
      hatchShape.setAttribute("opacity", String(1 - release));
      amp.setAttribute("opacity", (ease(ph(p, PHASES.ampFill)) * ampGone).toFixed(3));
      const kiss = ease(ph(p, PHASES.kiss));
      ampKiss.setAttribute("opacity", kiss.toFixed(3));
      ampKiss.setAttribute("transform", `translate(${(10 * kiss).toFixed(2)} ${(7 * kiss).toFixed(2)}) ${ampPlace}`);

      // The hatch: revealed across the cut faces, carried to the brim, then turned to dots.
      reveal.setAttribute("width", String(1400 * ease(ph(p, PHASES.hatch))));
      const H = ease(ph(p, PHASES.hatchMorph));
      const toBrim = (a: Pt[]) => a.map(([x, y], i) => [lerp(x, brim[i][0], H), lerp(y, brim[i][1], H)] as Pt);
      regionA.setAttribute("points", pts(toBrim(sectionA)));
      regionB.setAttribute("points", pts(toBrim(sectionB)));
      // Once the region has arrived, clip to the brim's exact shape.
      if (H >= 1) hatchShape.setAttribute("clip-path", "url(#ss-brim-clip)");
      else hatchShape.removeAttribute("clip-path");
      const settle = ease(ph(p, PHASES.settle));
      hatchPattern.setAttribute("patternTransform", `rotate(${lerp(45, 72, H).toFixed(2)})`);
      hatchBar.setAttribute("width", (0.9 * k).toFixed(2));
      hatchLines.setAttribute("opacity", (1 - settle).toFixed(3));
      hatchDots.setAttribute("opacity", settle.toFixed(3));
      svg.style.setProperty("--c-hatch", geo);

      // The plate's relations and dimensions, which fall away when the drawing lets go.
      const rel: [number, number, string][] = [
        [338, 286, "—"],
        [662, 286, "—"],
        [206, 356, "|"],
        [794, 356, "|"],
        [500, 250, "="],
        [500, 368, "◎"],
      ];
      s += `<g opacity="${1 - letGo}">`;
      rel.forEach(([x, y, g], i) => {
        s += badge(x, y, g, ph(p, stagger(PHASES.relations, rel.length, i, 0.015)), k);
      });
      const plateDims: Array<(t: number) => string> = [
        (t) => dim([780, 400], [220, 400], 54, "140", t, k),
        (t) => dim([780, 400], [780, 300], -44, "25", t, k),
        (t) => dim([445, 300], [555, 300], 70, "Ø28", t, k),
        (t) => dim([530, 400], [470, 400], 24, "Ø15", t, k),
        (t) => leader([224, 306], [196, 252], "3 × 45°", t, k),
      ];
      plateDims.forEach((f, i) => {
        s += f(ph(p, stagger(PHASES.dims, plateDims.length, i, 0.02)));
      });
      const labelT = ph(p, [PHASES.dims[1] - 0.015, PHASES.dims[1]]);
      if (labelT > 0) {
        s += `<g opacity="${labelT}"><text class="label" x="500" y="532">SECTION A–A</text><text class="label small" x="500" y="552">SCALE 2 : 1</text></g>`;
      }
      s += `</g>`;

      // The rowhouse's dimensions, in feet and inches, and its title.
      const houseDims: Array<(t: number) => string> = [
        (t) => dim(hp(16, 0), hp(0, 0), 30, `16'-0"`, t, k),
        (t) => dim(hp(16, 32), hp(16, 0), 44, `32'-0"`, t, k),
        (t) => dim(hp(0, 0), hp(0, 3), 40, `3'-0"`, t, k),
        (t) => dim(hp(0, 3), hp(0, 12.75), 40, `9'-9"`, t, k),
        (t) => dim(hp(0, 12.75), hp(0, 22.25), 40, `9'-6"`, t, k),
        (t) => dim(hp(0, 22.25), hp(0, 32), 40, `9'-9"`, t, k),
        (t) => dim(hp(10.25, 28.8), hp(13.25, 28.8), 12, `3'-0"`, t, k),
      ];
      houseDims.forEach((f, i) => {
        s += f(ph(p, stagger(PHASES.houseDims, houseDims.length, i, 0.02)));
      });
      const titleT = ph(p, [PHASES.houseDims[1] - 0.015, PHASES.houseDims[1]]);
      if (titleT > 0) {
        s += `<g opacity="${titleT}"><text class="label" x="500" y="${hy(0) + 62}">FRONT ELEVATION</text><text class="label small" x="500" y="${hy(0) + 80}">PHILADELPHIA ROWHOUSE · 1/4" = 1'-0"</text></g>`;
      }

      // The pen, at the tip of the stroke being drawn.
      if (tip) {
        const r = 7 * k;
        const [x, y] = tip;
        s += `<circle class="pen-dot" cx="${x}" cy="${y}" r="${2.6 * k}"/><path class="pen-cross" d="M${x - r * 2} ${y}H${x - r}M${x + r} ${y}H${x + r * 2}M${x} ${y - r * 2}V${y - r}M${x} ${y + r}V${y + r * 2}"/>`;
      }
      scene.innerHTML = s;
    }

    return { render, measure };
  }

  function init() {
    const root = document.querySelector<HTMLElement>(".sketch-bg");
    if (!root) return;
    const { render, measure } = setup(root);
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    let target = 0,
      shown = -1,
      raf = 0;

    // Progress through the whole page.
    const progress = () => {
      const span = document.documentElement.scrollHeight - window.innerHeight;
      return span > 0 ? clamp(window.scrollY / span) : 0;
    };
    const tick = () => {
      raf = 0;
      // Ease towards the scroll position, so wheel steps glide rather than jump.
      const next = shown < 0 ? target : shown + (target - shown) * 0.14;
      shown = Math.abs(target - next) < 0.0005 ? target : next;
      render(shown);
      if (shown !== target) raf = requestAnimationFrame(tick);
    };
    const onScroll = () => {
      if (reduce.matches) return;
      target = progress();
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const apply = () => {
      // With reduced motion, the backdrop stays out of the way entirely.
      root.hidden = reduce.matches;
      if (reduce.matches) return;
      measure();
      shown = -1;
      onScroll();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", apply);
    reduce.addEventListener("change", apply);
    apply();
  }

  init();
</script>

<style>
  /* Fixed behind the page's content (main is its stacking context; see global.css). */
  .sketch-bg {
    position: fixed;
    inset: 60px 0 0 0; /* clear of the sticky site header */
    z-index: -1;
    pointer-events: none;
    opacity: 0;
  }
  .sketch-bg[hidden] {
    display: none;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    --k: 1;
    --tk: 1;
    --c-geo: var(--under);
    --c-hatch: var(--under);
  }

  /* SVG styles: --c-geo and --c-hatch are set per frame; widths scale with --k. */
  svg :global(.grid-minor) {
    fill: none;
    stroke: var(--grid);
    stroke-width: 1;
  }
  svg :global(.grid-major) {
    fill: none;
    stroke: var(--grid-major);
    stroke-width: 1;
  }
  svg :global(.geo) {
    fill: none;
    stroke: var(--c-geo);
    stroke-width: calc(1.7px * var(--k));
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  svg :global(.geo.fig) {
    stroke-width: calc(1.5px * var(--k));
  }
  svg :global(.geo.thin) {
    stroke-width: calc(1px * var(--k));
  }
  svg :global(.geo.centre) {
    stroke-width: calc(0.8px * var(--k));
    stroke-dasharray: 18 4 3 4;
  }
  svg :global(.art .hat),
  svg :global(.art .skin) {
    fill: var(--figure-ink);
  }
  svg :global(.art .hair),
  svg :global(.art .brow) {
    fill: var(--figure-hair);
  }
  svg :global(.art .eye) {
    fill: var(--figure-eyes);
  }
  svg :global(.art .lips) {
    fill: var(--figure-lips);
  }
  svg :global(.amp) {
    fill: var(--figure-ink);
  }
  svg :global(.amp-kiss) {
    fill: var(--kiss);
  }
  svg :global(.hatch) {
    fill: url(#ss-hatch);
  }
  svg :global(.hatch-bar) {
    fill: var(--c-hatch);
  }
  svg :global(.dots) {
    fill: url(#ss-dots);
  }
  svg :global(.dot) {
    fill: var(--figure-ink);
  }
  svg :global(.brick) {
    fill: url(#ss-brick);
  }
  svg :global(.brick-line) {
    fill: none;
    stroke: var(--c-geo);
    stroke-width: calc(0.7px * var(--k));
    opacity: 0.55;
  }
  svg :global(.ext),
  svg :global(.dimline) {
    fill: none;
    stroke: var(--text-weak);
    stroke-width: calc(0.9px * var(--k));
  }
  svg :global(.arrow) {
    fill: var(--text-weak);
  }
  svg :global(.dimtext) {
    fill: var(--ink);
    font-family: var(--font);
    font-size: calc(13px * var(--tk));
    font-weight: 500;
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }
  svg :global(.dimtext[text-anchor="end"]) {
    text-anchor: end;
  }
  svg :global(.label) {
    fill: var(--ink);
    font-family: var(--font);
    font-size: calc(14px * var(--tk));
    font-weight: 700;
    letter-spacing: 0.12em;
    text-anchor: middle;
  }
  svg :global(.label.small) {
    fill: var(--text-weak);
    font-size: calc(11px * var(--tk));
    font-weight: 500;
  }
  svg :global(.badge rect) {
    fill: var(--raised);
    stroke: var(--line-strong);
    stroke-width: calc(1px * var(--k));
  }
  svg :global(.badge text) {
    fill: var(--under);
    font-family: var(--font);
    font-size: calc(11px * var(--k));
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: middle;
  }
  svg :global(.pen-dot) {
    fill: var(--accent);
  }
  svg :global(.pen-cross) {
    stroke: var(--text);
    stroke-width: calc(1px * var(--k));
  }
</style>
