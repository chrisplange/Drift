---
// Fonts, self-hosted: Archivo (with its width axis) for display and text, IBM Plex Mono for
// sheet labels, Inter Tight Light for dimension figures.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/inter-tight/latin-300.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import { screen } from "../lib/screens";
import { site } from "../site.config.mjs";

interface Props {
  title?: string;
  description?: string;
  /** The front page: its header hides the small wordmark until the big one has scrolled away. */
  home?: boolean;
}

const { title, home = false, description = `${site.name}: ${site.tagline.toLowerCase()}. Now in beta for Windows, macOS and the browser.` } =
  Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
// Absolute links need the site's address (SITE_URL); without one they're left out.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// The share image is made from the guide's window screenshot, so it stays current.
const shareImage = await getImage({ src: screen("window"), width: 1200, height: 750, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="256x256" />
    <meta name="theme-color" content="#0c0c0e" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: 100;
    background: var(--text);
    color: var(--bg);
    padding: 8px 12px;
  }
  .skip:focus {
    left: 8px;
  }
  main {
    min-height: 70vh;
  }
</style>
