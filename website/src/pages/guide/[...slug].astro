---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { guideHref, guideNav, guideTitle } from "../../lib/guide";

export async function getStaticPaths() {
  const entries = await getCollection("guide");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = guideTitle(entry);
const nav = await guideNav();
const flat = nav.flatMap((g) => g.items);
const here = flat.findIndex((i) => i.id === entry.id);
const prev = here > 0 ? flat[here - 1] : undefined;
const next = here >= 0 && here < flat.length - 1 ? flat[here + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={entry.id === "index" ? "User guide" : title}>
  <div class="wrap layout">
    <aside class="sidebar">
      <details open>
        <summary>Guide contents</summary>
        <nav aria-label="Guide">
          {
            nav.map((group) => (
              <div class="group">
                <h2>{group.label}</h2>
                <ol class:list={{ numbered: group.label === "Tutorials" }}>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={item.id === entry.id ? "page" : undefined}>
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="prose">
      <Content />
      <nav class="pager" aria-label="Previous and next page">
        {
          prev ? (
            <a class="prev" href={prev.href}>
              <span>Previous</span>
              {prev.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={next.href}>
              <span>Next</span>
              {next.title}
            </a>
          )
        }
      </nav>
    </article>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // The sidebar starts collapsed on narrow screens.
  const details = document.querySelector<HTMLDetailsElement>(".sidebar details");
  if (details && matchMedia("(max-width: 900px)").matches) details.open = false;
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr) 200px;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .sidebar,
  .toc {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    font-size: 0.9rem;
  }
  summary {
    display: none;
  }
  .group + .group {
    margin-top: 22px;
  }
  .sidebar h2,
  .toc h2 {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-weak);
    margin: 0 0 6px;
  }
  .sidebar ol,
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sidebar ol.numbered {
    counter-reset: n;
  }
  .sidebar ol.numbered a::before {
    counter-increment: n;
    content: counter(n);
    display: inline-block;
    width: 1.6em;
    color: var(--text-weak);
    font-family: var(--mono);
    font-size: 0.8em;
  }
  .sidebar a {
    display: block;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    color: var(--text-weak);
    line-height: 1.35;
  }
  .sidebar a:hover {
    color: var(--text);
    background: var(--raised);
    text-decoration: none;
  }
  .sidebar a[aria-current="page"] {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .toc {
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }
  .toc li {
    margin: 6px 0;
    line-height: 1.35;
  }
  .toc a {
    color: var(--text-weak);
  }
  .toc a:hover {
    color: var(--text);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
  }
  .pager a {
    display: block;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--text);
    font-weight: 600;
  }
  .pager a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .pager span {
    display: block;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-weak);
  }
  .pager .next {
    grid-column: 2;
    text-align: right;
  }
  @media (max-width: 1180px) {
    .layout {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 20px;
    }
    .sidebar {
      position: static;
      max-height: none;
    }
    summary {
      display: block;
      cursor: pointer;
      padding: 10px 14px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--panel);
      font-weight: 600;
    }
    details[open] summary {
      margin-bottom: 14px;
    }
  }
</style>
