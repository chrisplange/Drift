---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import DownloadButtons from "../components/DownloadButtons.astro";
import SketchScroll from "../components/SketchScroll.astro";
import { screen } from "../lib/screens";
import { friendlyVersion, getReleases } from "../lib/releases";
import { site } from "../site.config.mjs";

const releases = await getReleases();
const latest = releases[0];
const next = site.nextRelease;
const nextIsOut = releases.some((r) => r.version === next.version);

const features: { img?: string; visual?: "ai"; title: string; text: string }[] = [
  {
    img: "dims-fully-defined",
    title: "Dimensions that drive the drawing",
    text: "Smart dimensions read what you click: lengths, angles, radii, distances. Type a new value and the geometry follows. Blue means still free; white means fully defined.",
  },
  {
    img: "relations-pie",
    title: "Relations at a flick",
    text: "Hold Q and flick towards horizontal, tangent, equal or symmetric. Drift adds the obvious ones as you draw, and refuses ones that would over-define the sketch, with a reason.",
  },
  {
    img: "parameters",
    title: "Parameters and variants",
    text: "Name a value, width = 1200, and drive dimensions with expressions. Drag a slider to watch the sketch re-solve, and keep named variants to compare options side by side.",
  },
  {
    img: "view-crops",
    title: "Views on the canvas",
    text: "Crop named views of the model right on the canvas, Revit-style, and place them on sheets. Each view picks its layers and its own dimensions and notes; section and elevation marks link to the views they cut.",
  },
  {
    img: "fills",
    title: "Poché, hatches and fills",
    text: "Click inside a closed area to hatch it: concrete, earth, insulation, brick, or any AutoCAD or Revit .pat file. Fills stay on their outlines through every edit.",
  },
  {
    img: "blocks",
    title: "Blocks and a furniture library",
    text: "Doors, windows, fixtures and furniture to drop in, or make blocks of your own. Edit one and every copy updates. DXF blocks come across both ways.",
  },
  {
    img: "sheet",
    title: "Sheets, title blocks and output",
    text: "Lay views out on A4 to A0 or ANSI sheets with a title block and revisions. Export true-scale vector PDF, SVG or DXF, and trace over PDF and DXF underlays.",
  },
  {
    img: "sheet-views",
    title: "Colour, greyscale or black & white",
    text: "Choose per sheet how it prints: in colour, in greys, or as a crisp monochrome plot. The sheet preview shows exactly what comes out.",
  },
  {
    visual: "ai",
    title: "Draw with AI",
    text: "drift-mcp lets Claude and other MCP assistants sketch, constrain, dimension, render and analyse Drift drawings: live, in the drawing you have open, or from a short Drift script.",
  },
];

// What the next release (site.nextRelease) brings: the front page's "What's new" section.
const news: { title: string; text: string; href?: string }[] = [
  {
    title: "Assistants in your open drawing",
    text: "Turn on the live link and Claude and other MCP assistants work on the drawing open in Drift. Watch each change as it happens, undo it, or keep drawing yourself.",
    href: `${site.repoUrl}/blob/main/docs/ai.md`,
  },
  {
    title: "Drift script",
    text: "Describe a drawing by intent: rooms, walls, doors, windows, grids and hatches, by name. Drift builds it in one step you can undo.",
  },
  {
    title: "Notes for some views only",
    text: "Dimensions and notes can appear in just the views they belong to, like a note meant only for a detail, as in Revit.",
  },
  {
    title: "Project title blocks",
    text: "Set the project's name, number, client and address once, and every sheet's title block shows them, with an architectural layout and a status for each sheet.",
  },
  {
    title: "Steadier fillets",
    text: "Sketches with filleted corners keep their shape while you drag them.",
  },
  {
    title: "Crops at a keystroke",
    text: "Shift+Alt+B shows or hides view crops, and crops snap while you drag them.",
  },
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <a class="pill" href="/releases/">
          {latest ? `${friendlyVersion(latest.version)} is out` : "Release notes"}
        </a>
        <h1>Sketch with <em>intent</em>.<br /><span>Change your mind <em>freely</em>.</span></h1>
        <p class="lede">
          Start messy. End perfect. Drift handles everything in between, and never asks you to
          commit too early.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/download/">Download the beta</a>
          <a class="btn" href="/app/">Try it in your browser</a>
        </div>
        <p class="platforms">Windows · macOS · Browser · Now in beta</p>
      </div>
      <div class="hero-shot">
        <Image
          src={screen("window")}
          alt="Drift's window: a dimensioned mounting plate, the tool bar on the left and the Inspector on the right"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 640px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <SketchScroll />

  <section class="section features" id="features">
    <div class="wrap">
      <p class="eyebrow">What's in it</p>
      <h2>The precision of CAD, <em>the pace of a sketch</em></h2>
      <p class="lede">
        Drift borrows constraint sketching from mechanical CAD and makes it quick enough for
        early design: plans, sections, details, joinery, signage and fabrication drawings.
      </p>
      <div class="grid">
        {
          features.map((f) => (
            <article class="feature">
              <div class="shot">
                {f.img ? (
                  <Image src={screen(f.img)} alt="" widths={[480, 720]} sizes="(max-width: 760px) 100vw, 360px" />
                ) : (
                  <div class="ai" aria-hidden="true">
                    <p class="ask">Draw a 1200 × 600 table top with 40 mm corners, fully dimensioned.</p>
                    <p class="reply">
                      <span>4 lines · 4 arcs · 6 dimensions</span>
                      <b>Fully defined</b>
                    </p>
                  </div>
                )}
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section news" id="whats-new">
    <div class="wrap">
      <p class="eyebrow">{nextIsOut ? `${next.name} is out` : `Coming in ${next.name}`}</p>
      <h2>What's <em>new</em> in {next.name}</h2>
      <p class="lede">
        {
          nextIsOut ? `${next.name} is here. Here's what's new.` : `${next.name} is on its way. Here's what it brings.`
        }
      </p>
      <ul class="news-list">
        {
          news.map((n) => (
            <li>
              <h3>{n.href ? <a href={n.href}>{n.title}</a> : n.title}</h3>
              <p>{n.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="news-links">
        {nextIsOut && <a class="btn btn-primary" href="/download/">Get {next.name}</a>}
        <a href="/releases/">All release notes →</a>
      </p>
    </div>
  </section>

  <section class="section designers">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Feels familiar</p>
        <h2>Keys you <em>already know</em></h2>
        <p>
          Drift is made for people who already draw in Revit, AutoCAD,
          SolidWorks, Illustrator or Affinity. Units can be millimetres or feet-and-inches with
          fractions, typed any way you like: <code>1'-6 1/2"</code>, <code>450mm</code>,
          <code>=width/2</code>.
        </p>
        <p>
          The pen draws like Illustrator's. G moves and R rotates, Blender-style, with X and Y to
          lock an axis. Ctrl/⌘+K finds every command.
        </p>
        <a href="/guide/coming-from/">Coming from another program →</a>
      </div>
      <ul class="facts">
        <li><strong>Fast</strong><span>Sketches of thousands of entities solve in milliseconds, on the GPU-drawn canvas.</span></li>
        <li><strong>Exact</strong><span>Lines, arcs and text stay crisp at any zoom, and files keep every number exactly.</span></li>
        <li><strong>Plays well with others</strong><span>DXF in and out, plus SVG, PDF and Illustrator import, as geometry or as an underlay to trace.</span></li>
        <li><strong>Yours</strong><span>Plain-text .drift files that diff in git. No account, nothing in the cloud.</span></li>
      </ul>
    </div>
  </section>

  <section class="section try">
    <div class="wrap try-inner card">
      <div>
        <p class="eyebrow">No install</p>
        <h2>Try Drift <em>in your browser</em></h2>
        <p class="lede">
          The full app runs in the browser with WebGPU, or WebGL2 on older browsers. Your work
          is kept in the browser between visits, and you can download it as a .drift file.
        </p>
      </div>
      <a class="btn btn-primary" href="/app/">Open Drift</a>
    </div>
  </section>

  <section class="section get" id="download">
    <div class="wrap">
      <p class="eyebrow">Download</p>
      <h2>Get the <em>beta</em></h2>
      <p class="lede">
        Drift is in beta for Windows and macOS, and runs in your browser too.{" "}
        <a href="/licence/">About the licence</a>.
      </p>
      <DownloadButtons compact />
      <p class="links">
        <a href="/guide/">Read the user guide</a>
        <a href="/releases/">What's new</a>
        <a href={site.repoUrl}>Source on GitHub</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 72px 0 40px;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 48px;
    align-items: center;
  }
  .hero h1 {
    margin-top: 18px;
  }
  .hero h1 span {
    color: var(--text-weak);
  }
  .pill:hover {
    text-decoration: none;
    color: var(--text);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .platforms {
    color: var(--text-weak);
    font-size: 0.85rem;
    margin-top: 16px;
  }
  .hero-shot {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    overflow: hidden;
    box-shadow:
      0 40px 120px -30px color-mix(in srgb, var(--accent) 45%, transparent),
      0 30px 80px -20px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.04);
    transform: perspective(1600px) rotateY(-6deg) rotateX(2deg);
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hero-shot:hover {
    transform: perspective(1600px) rotateY(0deg) rotateX(0deg);
  }
  .hero-shot img {
    display: block;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }
  /* Each feature is a card, so its text never sits on the drawing behind the page. */
  .feature {
    padding: 10px 10px 22px;
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 96%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .feature h3,
  .feature p {
    padding: 0 10px;
  }
  .feature .shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin-bottom: 18px;
    background: var(--surface);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .feature:hover .shot {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
    box-shadow: var(--glow);
  }
  .feature img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .feature:hover img {
    transform: scale(1.04);
  }
  .ai {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: 22px;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      var(--surface);
    font-size: 0.85rem;
  }
  .ai p {
    margin: 0;
    color: var(--text);
  }
  .ai .ask {
    align-self: flex-end;
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 16px 16px 4px 16px;
    background: var(--raised);
    border: 1px solid var(--line-strong);
  }
  .ai .reply {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-weak);
  }
  .ai .reply span {
    color: var(--text-weak);
  }
  .ai .reply b {
    font-family: var(--font);
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ok) 16%, transparent);
    color: var(--ok);
  }
  .news-list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .news-list li {
    background: var(--panel);
    padding: 24px;
  }
  .news-list h3 a {
    color: var(--text);
  }
  .news-list p {
    margin: 0;
    color: var(--text-weak);
    font-size: 0.95rem;
  }
  .news-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }
  .feature p {
    color: var(--text-weak);
    font-size: 0.95rem;
    margin: 0;
  }

  .designers {
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .two p {
    color: var(--text-weak);
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .facts li {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 16px;
  }
  .facts span {
    color: var(--text-weak);
  }

  .try-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 60%),
      radial-gradient(ellipse at 0% 100%, color-mix(in srgb, var(--kiss) 14%, transparent), transparent 55%),
      var(--panel);
  }
  .try-inner .lede {
    margin-bottom: 0;
  }

  .get .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 40px;
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .hero-shot {
      transform: none;
    }
    .hero-inner,
    .two {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .grid,
    .news-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 40px;
    }
    .grid,
    .news-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .try-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
    .section {
      padding: 64px 0;
    }
  }
</style>
