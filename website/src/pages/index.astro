---
import Base from "../layouts/Base.astro";
---

<!-- The front page is a drawing sheet: four columns with their rules showing, the wordmark drawn as
     constrained geometry, four features, and a title block. -->
<Base home>
  <div class="wrap sheet">
    <div class="rules" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <section class="hero" aria-label="Drift">
      <div class="hero-pin">
        <svg id="mark" viewBox="0 -70 1520 470" role="img" aria-label="DRIFT">
          <line class="cons" x1="-20" y1="36" x2="1420" y2="36"></line>
          <line class="cons" x1="-20" y1="330" x2="1420" y2="330"></line>
          <g>
            <path class="glyph" fill-rule="evenodd" d="M0 36 L150 36 C240 36 300 100 300 183 C300 266 240 330 150 330 L0 330 Z M78 102 L145 102 C195 102 222 135 222 183 C222 231 195 264 145 264 L78 264 Z"></path>
            <path class="glyph" fill-rule="evenodd" d="M342 36 L502 36 C580 36 632 80 632 145 C632 195 600 230 555 242 L632 330 L542 330 L472 252 L420 252 L420 330 L342 330 Z M420 102 L495 102 C530 102 552 120 552 145 C552 170 530 188 495 188 L420 188 Z"></path>
            <path class="glyph" d="M674 36 L764 36 L764 330 L674 330 Z"></path>
            <path class="glyph" d="M806 36 L1056 36 L1056 102 L884 102 L884 156 L1030 156 L1030 220 L884 220 L884 330 L806 330 Z"></path>
            <path class="glyph" d="M1100 36 L1400 36 L1400 102 L1289 102 L1289 330 L1211 330 L1211 102 L1100 102 Z"></path>
          </g>
          <g class="dims">
            <!-- overall width: extension lines down from the baseline corners, value in a break in the line -->
            <path class="ext" d="M0 338V398M1400 338V398"></path>
            <path class="dim" d="M0 386H636M764 386H1400"></path>
            <polygon class="arw" points="0,386 14,382.5 14,389.5"></polygon>
            <polygon class="arw" points="1400,386 1386,382.5 1386,389.5"></polygon>
            <text class="dimt" x="700" y="392" text-anchor="middle">1400.00</text>
            <!-- cap height: extension lines out from the T, value along the line -->
            <path class="ext" d="M1408 36H1462M1408 330H1462"></path>
            <path class="dim" d="M1450 36V146M1450 220V330"></path>
            <polygon class="arw" points="1450,36 1446.5,50 1453.5,50"></polygon>
            <polygon class="arw" points="1450,330 1446.5,316 1453.5,316"></polygon>
            <text class="dimt" x="1450" y="183" text-anchor="middle" dominant-baseline="middle" transform="rotate(-90 1450 183)">294.00</text>
          </g>
        </svg>

        <div class="thesis">
          <span class="label">2D technical illustration for designers and artists · in beta</span>
          <h1>Draw it wrong first.</h1>
          <p>
            Rough it in. Then say what you meant: this wall is 12 feet, that gap is 900 mm, these two
            match. The drawing pulls itself into shape.
          </p>
        </div>
      </div>
    </section>
  </div>

  <div class="wrap sheet">
    <div class="rules" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <section class="zones" id="features">
      <h2>Numbers that push back</h2>
      <article class="zone lead">
        <span class="label"><span>A</span><span>12′ → 14′</span></span>
        <h3>Change a number. Watch the wall move.</h3>
        <p>The dimension is the drawing. Type a new one, in feet or millimeters, and everything tied to it follows.</p>
      </article>
      <article class="zone">
        <span class="label"><span>B</span><span>Q</span></span>
        <h3>Hold Q and flick</h3>
        <p>Parallel. Tangent. Equal. Done.</p>
      </article>
      <article class="zone">
        <span class="label"><span>C</span><span>.dwg</span></span>
        <h3>Bring the old files</h3>
        <p>DWG, DXF, PDF, Illustrator. Trace right over them.</p>
      </article>
      <article class="zone">
        <span class="label"><span>D</span><span>AI</span></span>
        <h3>Lend Claude the pencil</h3>
        <p>It draws in the file you have open. You keep the undo.</p>
      </article>
    </section>

    <section class="end" aria-label="Get Drift">
      <a class="big" href="/app/">
        <svg viewBox="0 0 1400 170" role="img" aria-label="Try the demo">
          <text x="0" y="150" textLength="1400" lengthAdjust="spacingAndGlyphs" font-size="190">TRY THE DEMO ↗</text>
        </svg>
      </a>
      <div class="tb">
        <div><span class="label">Project</span><span class="v">Drift</span></div>
        <div><span class="label">Status</span><span class="v">In beta</span></div>
        <div><span class="label">Runs on</span><span class="v">Windows · macOS · Browser</span></div>
        <div><span class="label">Sheet</span><a class="btn btn-primary" href="/download/">Download</a></div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sheet {
    position: relative;
  }
  /* the visible grid */
  .rules {
    position: absolute;
    inset: 0 16px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    pointer-events: none;
  }
  @media (min-width: 720px) {
    .rules {
      inset: 0 32px;
    }
  }
  .rules span {
    border-left: 1px solid var(--line);
  }
  .rules span:last-child {
    border-right: 1px solid var(--line);
  }
  .sheet > section {
    position: relative;
  }

  /* hero */
  .hero-pin {
    padding-top: clamp(24px, 5vw, 56px);
  }
  .hero:global(.scrub) {
    height: calc(100vh - var(--header) + var(--scrub));
  }
  .hero:global(.scrub) .hero-pin {
    position: sticky;
    top: var(--header);
  }
  .hero svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .glyph {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .cons {
    stroke: var(--text);
    stroke-width: 0.8;
    stroke-dasharray: 6 5;
    fill: none;
    opacity: 0.55;
  }
  .ext {
    stroke: var(--annot);
    stroke-width: 0.75;
    fill: none;
  }
  .dim {
    stroke: var(--annot);
    stroke-width: 1;
    fill: none;
  }
  .arw {
    fill: var(--annot);
  }
  .dimt {
    font-family: var(--dimfont);
    font-weight: 300;
    font-size: 18px;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    fill: var(--annot);
  }
  .thesis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(32px, 6vw, 80px);
    padding-bottom: clamp(40px, 7vw, 96px);
  }
  .thesis .label {
    grid-column: 1 / -1;
    margin-bottom: 14px;
  }
  .thesis h1 {
    grid-column: 1 / 3;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-stretch: 85%;
    line-height: 1;
    margin: 0;
    padding-right: 24px;
  }
  .thesis p {
    grid-column: 3 / 5;
    margin: 0;
    max-width: 52ch;
    align-self: end;
    color: var(--text-weak);
    padding-left: 16px;
  }

  /* features */
  .zones {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: clamp(48px, 8vw, 112px) 0;
  }
  .zones h2 {
    grid-column: 1 / -1;
    font-size: clamp(2.75rem, 8.5vw, 8rem);
    line-height: 0.86;
    margin: 0 0 clamp(32px, 5vw, 64px);
  }
  .zone {
    padding: 20px 16px 28px;
    border-top: 2px solid var(--text);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .zone .label {
    display: flex;
    justify-content: space-between;
  }
  .zone h3 {
    font-size: 1.25rem;
    margin: 0;
  }
  .zone p {
    margin: 0;
    color: var(--text-weak);
    font-size: 0.95rem;
  }
  .zone.lead {
    background: var(--text);
    color: var(--bg);
  }
  .zone.lead p,
  .zone.lead .label {
    color: #55554f;
  }
  .zone.lead h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-stretch: 75%;
    line-height: 0.95;
  }

  /* sign-off and title block */
  .end {
    padding-top: clamp(40px, 6vw, 80px);
  }
  .big {
    display: block;
    text-decoration: none;
  }
  .big svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .big text {
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 75%;
    fill: var(--text);
    transition: fill 0.2s;
  }
  .big:hover text {
    fill: var(--accent);
  }
  .tb {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    border: 2px solid var(--text);
    margin: 24px 0 0;
    background: var(--bg);
  }
  .tb > div {
    padding: 10px 12px;
    border-left: 1px solid var(--text);
    min-width: 0;
  }
  .tb > div:first-child {
    border-left: 0;
  }
  .tb .label {
    display: block;
    margin-bottom: 4px;
  }
  .tb .v {
    font: 800 0.95rem var(--display);
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .rules {
      grid-template-columns: repeat(2, 1fr);
    }
    .rules span:nth-child(n + 3) {
      display: none;
    }
    .thesis,
    .zones {
      grid-template-columns: 1fr 1fr;
    }
    .thesis h1,
    .thesis p {
      grid-column: 1 / -1;
      padding: 0;
    }
    .thesis p {
      margin-top: 16px;
    }
    .zone {
      grid-column: 1 / -1;
      padding-left: 0;
      padding-right: 0;
    }
    .zone.lead {
      padding-left: 16px;
      padding-right: 16px;
    }
    .tb {
      grid-template-columns: 1fr 1fr;
    }
    .tb > div:nth-child(3) {
      border-left: 0;
    }
    .tb > div:nth-child(n + 3) {
      border-top: 1px solid var(--text);
    }
  }
</style>

<script>
  // The header's small wordmark appears once the big one has scrolled away.
  const head = document.getElementById("site-header")!;
  const mark = document.getElementById("mark")!;
  new IntersectionObserver(([e]) => head.classList.toggle("past", !e.isIntersecting), {
    rootMargin: "-64px 0px 0px 0px",
  }).observe(mark);

  // The wordmark is drawn the way Drift works: it opens as a rough sketch with every point thrown
  // off, and scrolling solves it into shape, fills it and dimensions it while the hero holds still.
  // Then the dimensions clear and the letters tip forward as the page moves on. Scrolling back up
  // runs it in reverse. Without JS, or with reduced motion, the finished wordmark simply shows.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const $$ = (s: string) => [...document.querySelectorAll<SVGElement>(s)];
    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    const span = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
    const play = (ms: number, frame: (t: number) => void) => {
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = clamp((now - t0) / ms);
        frame(t);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const glyphs = $$("#mark .glyph");
    const truth = glyphs.map((g) => g.getAttribute("d")!);
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647 - 0.5;
    // a lean, stretch and shift per letter, plus a little jitter on every point
    const centres = [150, 487, 719, 931, 1250];
    const throws = glyphs.map((_, li) => ({
      sx: 1 + rnd() * 0.5,
      sy: 1 + rnd() * 0.5,
      skew: rnd() * 0.5,
      dx: rnd() * 90,
      dy: rnd() * 60,
      cx: centres[li],
    }));
    // each coordinate pair becomes "x y X Y": its true and its thrown position
    const bent = truth.map((d, li) => {
      const t = throws[li];
      return d.replace(/(-?[\d.]+) (-?[\d.]+)/g, (_, xs: string, ys: string) => {
        const x = +xs, y = +ys;
        const X = t.cx + (x - t.cx) * t.sx + (y - 183) * t.skew + t.dx + rnd() * 24;
        const Y = 183 + (y - 183) * t.sy + t.dy + rnd() * 24;
        return `${x} ${y} ${X} ${Y}`;
      });
    });
    const shape = (li: number, k: number) =>
      bent[li].replace(/(-?[\d.]+) (-?[\d.]+) (-?[\d.]+) (-?[\d.]+)/g, (_, x: string, y: string, X: string, Y: string) =>
        `${(+x + (+X - +x) * k).toFixed(1)} ${(+y + (+Y - +y) * k).toFixed(1)}`,
      );

    const dimLines = $$("#mark .dims path").map((el) => {
      el.setAttribute("pathLength", "1");
      el.style.strokeDasharray = "1 1";
      el.style.strokeDashoffset = "1";
      return el;
    });
    const dimMarks = $$("#mark .dims text, #mark .dims polygon");
    const cons = $$("#mark .cons");
    const dims = document.querySelector<SVGGElement>("#mark .dims")!;
    [...dimMarks, ...cons].forEach((el) => (el.style.opacity = "0"));
    glyphs.forEach((g, li) => {
      g.style.fillOpacity = "0";
      g.setAttribute("d", shape(li, 1));
    });
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const frame = (t: number) => {
      const k = 1 - ease(span(t, 0.32, 0.62));
      glyphs.forEach((g, li) => {
        g.setAttribute("d", shape(li, k));
        g.style.fillOpacity = String(span(t, 0.62, 0.78));
      });
      cons.forEach((el) => (el.style.opacity = String(0.55 * span(t, 0.3, 0.5))));
      dimLines.forEach((el, i) => {
        const o = i / dimLines.length;
        el.style.strokeDashoffset = String(1 - span(t, 0.7 + o * 0.15, 0.9 + o * 0.1));
      });
      dimMarks.forEach((el) => (el.style.opacity = String(span(t, 0.85, 1))));
    };

    // SCRUB px of scrolling solves, fills and dimensions; over FALL px more the dimensions clear
    // and the letters fall. The hero lets go as they start to tip, so the page moves while they fall.
    const SCRUB = 900, FALL = 500;
    const hero = document.querySelector<HTMLElement>(".hero")!;
    hero.classList.add("scrub");
    hero.style.setProperty("--scrub", `${SCRUB + FALL * 0.25}px`);
    const fall = (f: number) => {
      dims.style.opacity = String(1 - span(f, 0, 0.25));
      cons.forEach((el) => (el.style.opacity = String(0.55 * (1 - span(f, 0, 0.25)))));
      const a = span(f, 0.25, 1) ** 2 * (Math.PI / 2);
      // seen from the front, a letter falling towards you shortens to its baseline and spreads at the top
      glyphs.forEach((g) => (g.style.transform = a ? `scale(${1 + 0.12 * Math.sin(a)}, ${Math.cos(a)})` : ""));
    };
    let ready = false;
    const onScroll = () => {
      if (!ready) return;
      frame(0.3 + 0.7 * clamp(scrollY / SCRUB));
      fall(clamp((scrollY - SCRUB) / FALL));
    };
    addEventListener("scroll", () => requestAnimationFrame(onScroll), { passive: true });
    setTimeout(() => play(700, (u) => frame(0.3 * u)), 150);
    setTimeout(() => {
      ready = true;
      onScroll();
    }, 900);
  }
</script>
